# syntax=docker/dockerfile:1
# ============================================================================
# Dockerfile.postgres — Postgres 16 + pgBackRest for the Polaris prod stack
#
# v9.126+ (production-readiness, Wave 3): continuous WAL archiving needs
# pgBackRest installed ON the database host, because the primary's
# archive_command (`pgbackrest --stanza=polaris archive-push %p`) runs inside
# the postgres process. The stock postgres:16-alpine image has no pgbackrest, so
# we extend it. The base is digest-pinned (same digest the compose used as a
# bare image) so a mutated/deleted upstream tag cannot change what runs;
# Dependabot's docker ecosystem bumps it.
#
# Archiving is OPT-IN at runtime (docker-init.sh enables archive_mode +
# archive_command only when POLARIS_PGBACKREST_ENABLED is set), so a deployment
# that has not provisioned a repo does not accumulate WAL. The repo LOCATION is
# rendered at every container start by pg-entrypoint.sh -> pgbackrest-conf.sh
# into /etc/pgbackrest/conf.d/repo.conf: a local filesystem repo by default
# (what the CI round-trip exercises; NOT offsite), or an S3 bucket when the
# POLARIS_PGBACKREST_S3_* env is set (roadmap P0.9; what the CI offsite drill
# exercises against MinIO). The S3 credentials are a separately mounted secret
# fragment, never env. See docs/operator/DR.md.
#
# Build context is the REPOSITORY ROOT (see docker-compose.prod.yml).
# ============================================================================
FROM postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685

# v9.138 — apk upgrade pulls patched apk packages on top of the pinned base
# (clears fixable apk-package CVEs; the one residual fixable CRITICAL is a Go
# stdlib CVE inside the base image's gosu binary, which does no TLS, so it is
# unreachable and .trivyignore'd). pgbackrest is in the distro package set; the
# dirs are owned by the postgres user so the archive_command (run as postgres)
# and stanza ops can write them.
RUN apk upgrade --no-cache \
    && apk add --no-cache pgbackrest \
    && mkdir -p /var/lib/pgbackrest /etc/pgbackrest/conf.d /var/log/pgbackrest \
    && chown -R postgres:postgres /var/lib/pgbackrest /etc/pgbackrest /var/log/pgbackrest \
    && rm -rf /var/cache/apk/*

# v9.173 (P0.9) — the repo-fragment renderer + the entrypoint wrapper that runs
# it on every start. conf.d is postgres-owned above so the renderer can write
# there whether the container starts as root (stock) or as postgres (restore).
COPY --chmod=0755 polaris_web/pgbackrest-conf.sh /usr/local/bin/polaris-pgbackrest-conf.sh
COPY --chmod=0755 polaris_web/pg-entrypoint.sh   /usr/local/bin/polaris-pg-entrypoint.sh

# v9.186 (roadmap P1.5) — the image is self-contained: the schema and its
# migrations, the init script, and the pgBackRest stanza config are baked in,
# so a Kubernetes pod needs no ConfigMaps for them. The compose stack keeps
# bind-mounting the live copies over these paths (dev freshness); the build
# context is therefore the repository root (see docker-compose.prod.yml).
COPY --chown=postgres:postgres polaris_sql /docker-entrypoint-initdb.d/sql
COPY --chmod=0755 polaris_web/docker-init.sh /docker-entrypoint-initdb.d/00-init.sh
COPY --chown=postgres:postgres polaris_web/pgbackrest.conf /etc/pgbackrest/pgbackrest.conf
ENTRYPOINT ["/usr/local/bin/polaris-pg-entrypoint.sh"]
CMD ["postgres"]
