# ============================================================================
# Sample nginx configuration for Polaris production deployment
#
# Drop into /etc/nginx/sites-available/polaris.conf and symlink into
# /etc/nginx/sites-enabled/. Replace the certificate paths and server_name
# with values for your environment.
#
# Assumes gunicorn is running on 127.0.0.1:5000 (the default in
# gunicorn.conf.py when POLARIS_PORT is unset). For Docker Compose deployments
# nginx would proxy to the app container by service name (`app:5000`).
# ============================================================================

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name polaris.example.gov;
    return 301 https://$host$request_uri;
}

# HTTPS server with TLS termination
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name polaris.example.gov;

    # TLS configuration — current Mozilla Intermediate profile
    ssl_certificate     /etc/letsencrypt/live/polaris.example.gov/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/polaris.example.gov/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # HSTS (only enable once you're committed to HTTPS-only)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Sane security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Static assets served directly by nginx for performance
    location /static/ {
        alias /opt/polaris/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Everything else proxied to gunicorn
    location / {
        proxy_pass         http://127.0.0.1:5000;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # Reasonable rate limit on POSTs to prevent abuse
    # (Define `limit_req_zone $binary_remote_addr zone=polaris:10m rate=10r/s;`
    #  in the http block of nginx.conf to use this.)
    # location ~ ^/(uc[1457]/|sql$|tokens/[0-9]+/transition$) {
    #     limit_req zone=polaris burst=20 nodelay;
    #     proxy_pass http://127.0.0.1:5000;
    # }
}
