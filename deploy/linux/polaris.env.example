# /etc/polaris/polaris.env — systemd EnvironmentFile for polaris.service (P1.1).
# Written by deploy/linux/install.sh; edit and `systemctl restart polaris`.
# Mode 0600, owner root: nothing in here is a secret, but keep it that way.

# REQUIRED. The public hostname. Caddy provisions a Let's Encrypt certificate
# for it, so its DNS A/AAAA record must point at this host and 80/443 must be
# reachable from the internet before the first start.
POLARIS_DOMAIN=polaris.example.org

# gunicorn workers (default 4). Roughly 2 x vCPU.
WEB_CONCURRENCY=4

# Continuous WAL archiving (docs/operator/DR.md). Leave 0 until the offsite
# repo below is configured; then set 1 and `scripts/polaris-deploy.sh prod`.
POLARIS_PGBACKREST_ENABLED=0
# Offsite backup repo by env alone (roadmap P0.9). The S3 key pair is NOT here:
# it is polaris_web/secrets/pgbackrest_repo_creds.conf.
POLARIS_PGBACKREST_S3_BUCKET=
POLARIS_PGBACKREST_S3_ENDPOINT=
POLARIS_PGBACKREST_S3_REGION=
POLARIS_PGBACKREST_S3_PATH=
POLARIS_PGBACKREST_S3_PORT=
POLARIS_PGBACKREST_S3_URI_STYLE=
POLARIS_PGBACKREST_S3_CA_FILE=

# Extra compose files for polaris.service. Leave EMPTY on a real server. CI
# sets "-f docker-compose.citest.yml" (internal-CA TLS edge, no public domain).
POLARIS_COMPOSE_EXTRA=
