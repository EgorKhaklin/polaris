# Polaris — .gitignore
# First created v8.35 (publish-readiness pass, 2026-05-12).

# ============================================================================
# macOS metadata
# ============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python venvs (the codex venv lives at /private/tmp/, not in-repo —
# but in case anyone clones and creates a venv here):
venv/
.venv/
env/
.env

# pytest / coverage / type-checker / linter caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ============================================================================
# Rust (polaris_zk/)
# ============================================================================
target/
Cargo.lock.bak
**/*.rs.bk

# ============================================================================
# Node / JS (atlas-globe.js vendored; nothing installed in-repo, but
# guard against accidental npm activity)
# ============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ============================================================================
# Editor / IDE
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
# Claude Code IDE state (per-user; v8.59). Comment on its own line:
# git does NOT honor trailing inline comments, so a bare pattern is required.
.claude/

# ============================================================================
# OS / shell artifacts
# ============================================================================
*.log
*.pid
*.seed
*.pid.lock
.history

# ============================================================================
# Polaris-specific runtime state
# ============================================================================
# State directory used by the launcher and dev server (env var
# POLARIS_STATE_DIR, defaults under /tmp). Should never be checked in.
polaris-state/
state/

# Local environment files (real env vars live in shell init or
# launcher, never on disk inside the repo).
.env
.env.local
.env.*.local
# v9.34: sourced by polaris-mycelium-wake.sh (operator-managed secrets).
# Comment on its own line: a trailing inline comment broke this pattern
# (git does not strip them), leaving operator secrets un-ignored until v9.45.
polaris.env
secrets.json
credentials.json

# Arc B Phase 1 (v8.77) production secrets — file-mounted by
# docker-compose.prod.yml from polaris_web/secrets/. Generated by
# scripts/polaris-generate-secrets.sh; rotated by polaris-rotate-secret.sh.
# G28 requires these never leave the host filesystem.
polaris_web/secrets/

# ============================================================================
# Build outputs from local Polaris docker workflows
# ============================================================================
polaris_web/docker-state/
polaris_web/.docker-volume/

# ============================================================================
# Documents that are generated, not source
# ============================================================================
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out
# `polaris_project_report.tex` is source; corresponding .pdf is
# checked in as the audit-of-record version of the report.

# ============================================================================
# Derived / auto-generated state (v9.34 polish per Class B1 decision)
# ============================================================================
# These files are rewritten by scripts on every read-side invocation,
# which dirties the tree and blocks the kill test. Past snapshots
# remain in git history (immutable per v8.20 AoR); going forward,
# these are operator-local state. `journal/<date>-architect.md` snapshots
# are KEPT tracked per the Architect persona's audit-of-record
# discipline (Class B2 decision).
meta/brain-map/brain-map.html
polaris_swarm/civitas/census-roll.json
polaris_swarm/civitas/treasury-roll.json

# Playwright MCP tool artifacts (browser console logs) - operator-local
.playwright-mcp/
